# Build context of the all-in-one image (Dockerfile), which needs the Go
# modules and the dashboard's sources. Everything the build does not
# read stays out of the context.
.git
.github
.claude
.claude-plugin
.scratch
# The dev stack's binary, log and data dir (scripts/dev-stack.sh).
.dev
.chunkhound
assets
docs
helm
playground
plugin
tests
sensor
contracts
**/bin
**/dist
!webui/dist/.gitkeep
**/node_modules
**/coverage*
dashboard/playwright-report
dashboard/test-results
**/*.md
!dashboard/**/*.md
**/.venv
**/__pycache__
**/*_test.go

# Never in an image: local environment files (a dashboard/.env with
# VITE_* values would be baked into the public bundle), keys and the
# binary's secrets file. The example env file is documentation.
**/.env*
!**/.env.example
**/*.pem
**/*.key
**/secrets.json
