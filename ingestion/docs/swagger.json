                                }
                            }
                        },
                        "description": "missing or invalid bearer token"
                    },
                    "413": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.OTLPStatus"
                                }
                            },
                            "application/x-protobuf": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.OTLPStatus"
                                }
                            }
                        },
                        "description": "body over 4 MiB, over 16 MiB decompressed, or past the decode memory limit"
                    },
                    "415": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.OTLPStatus"
                                }
                            },
                            "application/x-protobuf": {
                                "schema": {
                                    "$ref": "#/components/schemas/handlers.OTLPStatus"
                                }
                            }
