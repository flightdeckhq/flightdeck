# Variables the compose files read (copy to docker/.env, or export them).
# Everything the binary itself reads is documented in ARCHITECTURE.md
# (Deployment); the compose file passes FLIGHTDECK_DATABASE_URL and
# FLIGHTDECK_DOMAIN through and the rest keep their defaults.

# Host port the dashboard, /api and /ingest are published on
# (docker-compose.yml). The container always listens on 4000.
# FLIGHTDECK_PUBLISH_PORT=4000

# Empty: SQLite under the flightdeck_data volume. A postgres:// URL
# switches the backend; docker-compose.postgres.yml sets it for the
# bundled Postgres, so leave it unset with that file.
# FLIGHTDECK_DATABASE_URL=

# Required by docker-compose.postgres.yml: the bundled database's
# password. Letters and digits, or percent-encoded, since it is placed in
# the database URL.
# POSTGRES_PASSWORD=change-me

# TLS from the container: the public host name, with ports 80 and 443
# published in an override file. Plain HTTP on 4000 otherwise.
# FLIGHTDECK_DOMAIN=

# Dev stack only (docker-compose.dev.yml): another Postgres major, and
# where that image keeps its data (Postgres 18: /var/lib/postgresql).
# FLIGHTDECK_POSTGRES_IMAGE=postgres:16-alpine
# FLIGHTDECK_POSTGRES_DATA_DIR=/var/lib/postgresql/data
