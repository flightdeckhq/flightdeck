# Variables the compose files read. Copy to docker/.env (compose loads
# it from the directory of the first file it is given), or export them.
# Everything else the binary reads keeps its default; ARCHITECTURE.md
# (Deployment, Environment variables) lists it.

# --- docker-compose.yml: one flightdeck container, SQLite --------------

# The image. Default: the release this checkout is at.
# FLIGHTDECK_IMAGE=flightdeckhq/flightdeck:v0.8.0

# Where the dashboard, /api and /ingest are published on the host. The
# origin serves the dashboard token to whoever can reach it, so it is
# loopback unless you change it; 0.0.0.0 only behind a firewall or a
# proxy that authenticates. The container always listens on 4000.
# FLIGHTDECK_PUBLISH_HOST=127.0.0.1
# FLIGHTDECK_PUBLISH_PORT=4000

# A Postgres of your own instead of SQLite. Leave it unset with
# docker-compose.postgres.yml, which sets it for its bundled Postgres.
# FLIGHTDECK_DATABASE_URL=postgres://user:password@host:5432/flightdeck?sslmode=require

# TLS from the binary: the public host name. Ports 80 and 443 of the
# service must then be published from an override file; the binary no
# longer listens on 4000.
# FLIGHTDECK_DOMAIN=flightdeck.example.com

# --- docker-compose.postgres.yml: a bundled Postgres -------------------

# Required. Letters, digits and - . _ ~ only: the same value is the
# server's password and a part of the database URL.
#   openssl rand -hex 24
# POSTGRES_PASSWORD=

# --- docker-compose.dev.yml: the contributor dev stack (make dev) ------

# Another Postgres major, and where that image keeps its data (Postgres
# 18: /var/lib/postgresql). CI sets both.
# FLIGHTDECK_POSTGRES_IMAGE=postgres:16-alpine
# FLIGHTDECK_POSTGRES_DATA_DIR=/var/lib/postgresql/data
