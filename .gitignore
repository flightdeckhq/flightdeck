# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg
.venv/

# Go
bin/
tmp/
# The binary `go build ./cmd/flightdeck` drops at the repo root; the
# Makefile builds into bin/.
/flightdeck
/flightdeck.exe

# The dashboard bundle the flightdeck binary embeds; `make build-webui`
# fills it from dashboard/dist. The directory is un-ignored first (the
# `dist/` rule above would otherwise win), then its content ignored but
# for the .gitkeep, which keeps go:embed's pattern matching on a
# checkout without a bundle.
!/webui/dist/
webui/dist/*
!webui/dist/.gitkeep

# Node
node_modules/
.vite/

# The contributor dev stack's files (scripts/dev-stack.sh): the binary
# built from the checkout, its log and pid, the state file the test
# harness reads, and the data dir.
.dev/

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env

# Production runtime config. Operators may mount their own
# runtime-config.json over /usr/share/nginx/html/runtime-config.json
# inside the dashboard container. The repo-shipped default at
# dashboard/public/runtime-config.json is the dev token; ignore any
# host-side override file so a deployer's production token never
# accidentally lands in source control.
runtime-config.prod.json
docker/dashboard/runtime-config.json
docker/runtime-config.json

# Claude — the .claude/ directory ships with the repo (review pipeline,
# guidelines, audit-repo command, Stop hook). Personal permission
# allowlists land in settings.local.json which stays gitignored.
.claude/settings.local.json
tests/smoke/.venv-py312/

# Local scratch space + agent indices. Both are working scratchpads
# (probe screenshots, throwaway diffs, ChunkHound's local code-search
# index). They are per-developer artifacts and never belong in the
# tree.
.scratch/
.chunkhound/

# Playwright + go test outputs. Generated on every run; bulky and
# noisy in git status.
test-results/
playwright-report/
docker/test-results/

# Agent worktrees are full repository copies, never part of the tree.
.claude/worktrees/
